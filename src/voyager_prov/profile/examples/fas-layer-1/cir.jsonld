    "voyager": "urn:voyager:prov:"
  },
  "fasSource": "cir",
  "fasSourceName": "Commodity Intelligence Reports (CIR)",
  "hadPrimarySource": {
    "@id": "https://docs.google.com/presentation/d/1IybpPfUqDYji0ge-X0n165gMV8pU2UqlZQFKxIykk5k",
    "deckSlides": "20-21"
  },
  "sourceUrl": "https://ipadinternalportal.fas.usda.gov/ipad_home/search.aspx",
  "externalDeps": [
    "BeautifulSoup4",
    "requests",
    "GCP Vision OCR",
    "poppler-utils",
    "fitz (PyMuPDF)"
  ],
  "connectorSteps": [
    "C1 ASP.NET form POST enumerate CIR article links (__VIEWSTATE/__EVENTVALIDATION, ArchYear)",
    "C2 delta via utils.get_repo_ids",
    "C3 branch PDF \u2192 utils.parse_pdf(isCir=True) + OCR each page",
    "C4 branch HTM \u2192 utils.parse_htm (BS4 text + images)",
    "C5 release-date derivation from URL /highlights/YYYY/MM/ or in-text month regex",
    "C6 title regex from <b>Commodity Intelligence Report ...</b>",
    "C7 country scan (utils.countries + official_countries), minus 'United States Department of Agriculture'",
    "C8 image OCR child jobs (format_category='OCR Image')",
    "C9 build parent \u2192 image link graph"
  ],

    "GCP Vision OCR",
    "pycountry",
    "requests"
  ],
  "connectorSteps": [
    "C1 download monthly PDF (common.download_file)",
    "C2 locate matching .docx companion",
    "C3 docx2txt extract text + images",
    "C4 parse Heading 1/2/3 into per-brief chunks",
    "C5 regex extract author/phone/email/contact",
    "C6 country scan against pycountry lookups",
    "C7 child image jobs via utils.run_image (GCP Vision OCR)",
    "C8 SequenceMatcher associate images to briefs",
    "C9 build parent \u2192 article \u2192 image link graph"
  ],

    "requests"
  ],
  "connectorSteps": [
    "C1 OAuth client_credentials POST /newgainapi/token \u2192 bearer",
    "C2 POST /Search/GetSearchResults with all categoryIds (25-day sliding window)",
    "C3 per-report build download href via DownloadReportByFileName + urlencode",
    "C4 delta via utils.get_repo_ids",
    "C5 country map via utils.countries (China \u2192 China special-case)",
    "C6 reportCategory \u2192 in-file 13-bucket gain_categories taxonomy (default Food_Sector) \u2192 fs_gain_category"
  ],
